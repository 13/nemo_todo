# Copy to .env next to docker-compose.yml.
# true  = anyone may create an account
# false = nobody may (use `docker compose exec nemo nemo_server reset-password <user>` to recover)
# empty = open until the first account exists, then closed
NEMO_ALLOW_SIGNUP=
# Comma-separated origins for development builds served elsewhere, e.g. http://localhost:5000
NEMO_CORS_ORIGINS=

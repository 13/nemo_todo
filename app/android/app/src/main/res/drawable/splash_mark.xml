<?xml version="1.0" encoding="utf-8"?>
<!-- The launch splash: nemo's mark in a faint ring, exactly as the app's
     starting screen draws it (NemoSplashMark in lib/core/widgets/
     nemo_mark.dart): a 96 dp ring 3 dp wide at 18% and a 64 dp disc, so
     the system splash hands over to the app without anything moving.
     Change both together.

     The canvas is 288 dp because that is what Android 12's splash screen
     shows an icon without a background at, keeping the middle 192 dp; the
     launch background below Android 12 centres it at the same size. The
     mark is assets/logo/nemo-mark.svg, whose 400-wide disc is scaled by
     0.16 to 64 dp and centred. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">
    <path
        android:pathData="M144,97.5 a46.5,46.5 0 1,1 0,93 a46.5,46.5 0 1,1 0,-93 Z"
        android:strokeColor="@color/splash_mark"
        android:strokeAlpha="0.18"
        android:strokeWidth="3" />
    <group
        android:scaleX="0.16"
        android:scaleY="0.16"
        android:translateX="103.04"
        android:translateY="103.04">
        <path
            android:fillColor="@color/splash_mark"
            android:fillType="evenOdd"
            android:pathData="M 56 256 A 200 200 0 1 0 456 256 A 200 200 0 1 0 56 256 Z M 127.87 265.42 L 206.87 343.42 A 31.5 31.5 0 0 0 251.10 343.45 L 381.10 215.45 A 31.5 31.5 0 0 0 381.45 170.90 A 31.5 31.5 0 0 0 336.90 170.55 L 229.03 276.76 L 172.13 220.58 A 31.5 31.5 0 0 0 127.58 220.87 A 31.5 31.5 0 0 0 127.87 265.42 Z" />
    </group>
</vector>

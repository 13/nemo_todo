<?xml version="1.0" encoding="utf-8"?>
<!-- One task: its circle ticks it off, the rest opens it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_row"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/today_row_circle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="11dp"
        android:src="@drawable/today_widget_circle" />

    <LinearLayout
        android:id="@+id/today_row_text"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/today_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/today_row_due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

          "sql": "CREATE TABLE IF NOT EXISTS \"sync_log\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entity\" TEXT NOT NULL, \"row_id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL, \"for_user_id\" TEXT NULL, \"op\" TEXT NOT NULL);"

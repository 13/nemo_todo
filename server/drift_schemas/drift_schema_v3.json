  "fixed_sql": [
    {
      "name": "lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL DEFAULT 0, \"icon\" TEXT NOT NULL DEFAULT 'list', \"sort_key\" TEXT NOT NULL, \"owner_id\" TEXT NULL, \"is_inbox\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_inbox\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"done\" IN (0, 1)), \"done_at\" INTEGER NULL, \"due_at\" INTEGER NULL, \"due_has_time\" INTEGER NOT NULL DEFAULT 0 CHECK (\"due_has_time\" IN (0, 1)), \"remind\" INTEGER NOT NULL DEFAULT 0 CHECK (\"remind\" IN (0, 1)), \"priority\" INTEGER NOT NULL DEFAULT 0, \"tags\" TEXT NOT NULL, \"repeat\" TEXT NULL, \"sort_key\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "subtasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"subtasks\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"done\" IN (0, 1)), \"sort_key\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" TEXT NOT NULL, \"username\" TEXT NOT NULL UNIQUE, \"password_hash\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"token_hash\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"expires_at\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"token_hash\"));"
        }
      ]
    },
    {
      "name": "list_members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"list_members\" (\"list_id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"role\" TEXT NOT NULL, PRIMARY KEY (\"list_id\", \"user_id\"));"
        }
      ]
    },
